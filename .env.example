# Optional Next.js server-side URL. Omit to use http://127.0.0.1:8000.
MATCHIQ_API_URL=

# For Docker Compose, choose a local password and put its URL-encoded value in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=
# Example for Compose: postgresql://matchiq:encoded-password@db:5432/matchiq

# Optional provider keys. Leave blank to use OpenFootball.
FOOTBALL_DATA_TOKEN=
API_FOOTBALL_TOKEN=
SYNC_INTERVAL_SECONDS=14400

# Optional: SQLite cache file when DATABASE_URL is unset.
SIMULATION_CACHE_PATH=
